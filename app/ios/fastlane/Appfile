# iOS bundle identifier — the same id used on Android (`app/android/app/build.gradle.kts`'s
# `applicationId`) to both platforms.
app_identifier('com.ruaridhw.glean')

# Supplied via env at release time (a Mac laptop — this is deliberately not
# wired into CI). Never hardcode a real Apple
# ID or team id here since this file is committed.
apple_id(ENV['FASTLANE_APPLE_ID'])
team_id(ENV['FASTLANE_TEAM_ID']) # Developer Portal team
itc_team_id(ENV['FASTLANE_ITC_TEAM_ID']) # App Store Connect team, if ambiguous
