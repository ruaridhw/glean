# Android release lane — Play internal track (FLUTTER_MIGRATION.md §8,
# AC-CI-04).
#
# Driven from the Mac laptop only: `bundle exec fastlane internal` from this
# directory (`app/android/fastlane`). **Not wired into CI** — the
# workflow_dispatch-gated Android emulator job
# (../../.github/workflows/flutter-integration.yml) only ever runs
# integration tests against a debug-signed build, never a real Play upload.
#
# One-time setup this lane assumes is already done (Flutter's own Android
# deployment docs, not fastlane's):
#   keytool -genkey -v -keystore ~/glean-upload-keystore.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
# then `app/android/key.properties` (gitignored — see `app/.gitignore`):
#   storeFile=/absolute/path/to/glean-upload-keystore.jks
#   storePassword=...
#   keyAlias=upload
#   keyPassword=...
# `app/android/app/build.gradle.kts` reads this file when present and signs
# release builds with it; without it, release builds fall back to debug
# signing (so CI and any machine without the keystore keep working — they
# just can't produce anything this lane would actually upload).

require_relative '../../fastlane/release_config'

default_platform(:android)

platform :android do
  desc 'Build and upload a release to the Play internal track'
  lane :internal do
    defines = release_defines
    keystore_properties = File.join(Dir.pwd, '..', 'key.properties')
    unless File.exist?(keystore_properties)
      UI.user_error!(
        "#{keystore_properties} is missing — see this Fastfile's header " \
        'comment for the one-time keystore setup. Without it, ' \
        '`flutter build appbundle` would produce a debug-signed bundle, ' \
        'which the Play Console will reject.',
      )
    end

    package_name = 'com.ruaridhw.glean'
    track = 'internal'

    # AC-CI-05 — the explicit replacement for EAS's silent remote
    # build-number auto-increment (`appVersionSource: "remote"`,
    # `autoIncrement: true`): ask the Play Console for the highest version
    # code already uploaded to *any* track (a version code must be strictly
    # increasing across the whole app, not just one track) and increment it.
    version_code = next_play_version_code(package_name)

    UI.message("Building versionCode #{version_code} (-t lib/main.dart)")

    # `-t lib/main.dart` is explicit, not incidental: this lane must never
    # build `lib/main_e2e.dart` (AC-AUTH-07) —
    # `test/build/release_entrypoint_test.dart` extracts the resolved `-t`
    # target from the `sh(...)` call below and asserts it is exactly
    # `lib/main.dart`.
    sh(
      'cd ../.. && flutter build appbundle --release ' \
      "-t lib/main.dart --build-number=#{version_code} #{defines}",
    )

    upload_to_play_store(
      package_name: package_name,
      track: track,
      aab: '../../build/app/outputs/bundle/release/app-release.aab',
    )
  end
end
