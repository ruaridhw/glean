{
  "expo": {
    "name": "Glean",
    "slug": "glean",
    "owner": "ruaridhgithub",
    "version": "0.1.21",
    "scheme": "glean",
    "platforms": ["ios", "android"],
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ruaridhw.glean",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2e9d63"
      },
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Glean to scan receipts."
        }
      ],
      "expo-font"
    ],
    "updates": {
      "enabled": false
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#2e9d63"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "bd4d9a03-2d5a-4fc6-8e51-bb12f4420be5"
      }
    }
  }
}
