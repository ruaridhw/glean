{
  "expo": {
    "name": "Glean",
    "slug": "glean",
    "version": "0.1.2",
    "scheme": "glean",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ruaridhw.glean",
      "adaptiveIcon": {
        "backgroundColor": "#2a9d8f"
      },
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Glean to scan receipts."
        }
      ]
    ],
    "updates": {
      "enabled": false
    },
    "splash": {
      "backgroundColor": "#fdfaf6"
    }
  }
}
