#!/usr/bin/env bash
# Tap an element by visible text or by raw x y coordinates.
# Usage:
#   emu-tap "Discover"          # tap element with text "Discover"
#   emu-tap 540 1200            # tap raw coordinates
set -euo pipefail
ADB="$HOME/Library/Android/sdk/platform-tools/adb"
CACHE_DIR="$(cd "$(dirname "$0")/.." && pwd)/.cache"
mkdir -p "$CACHE_DIR"
DUMP="$CACHE_DIR/ui.xml"

if [[ $# -eq 2 ]] && [[ "$1" =~ ^[0-9]+$ ]] && [[ "$2" =~ ^[0-9]+$ ]]; then
  "$ADB" shell input tap "$1" "$2"
  exit 0
fi

LABEL="$1"
"$ADB" shell uiautomator dump /data/local/tmp/ui.xml >/dev/null 2>&1
"$ADB" pull /data/local/tmp/ui.xml "$DUMP" >/dev/null 2>&1

# Pull XML and find the node whose text matches (exact match)
XML=$(cat "$DUMP")
# Extract bounds for the matching text — format: bounds="[x1,y1][x2,y2]"
BOUNDS=$(echo "$XML" | tr '>' '\n' | grep "text=\"${LABEL}\"" | head -1 \
  | sed -n 's/.*bounds="\[\([0-9]*\),\([0-9]*\)\]\[\([0-9]*\),\([0-9]*\)\]".*/\1 \2 \3 \4/p')

if [[ -z "$BOUNDS" ]]; then
  echo "ERROR: no element with text \"$LABEL\" found on screen" >&2
  exit 1
fi

read -r X1 Y1 X2 Y2 <<< "$BOUNDS"
CX=$(( (X1 + X2) / 2 ))
CY=$(( (Y1 + Y2) / 2 ))
"$ADB" shell input tap "$CX" "$CY"
