# Machine-local Makefile overrides. Copy to .env.local (gitignored) and fill
# in. Hostnames, addresses and credentials never go in the Makefile, docs or
# any tracked file; keep the real values in your password manager.

# Web dev loop (make start-web). Only needed on a headless/remote box.
WEB_HOST=<address the browser can reach>
WEB_PORT=8090
WEB_HEADLESS=1
API_PORT=8000

# Cognito dev pool, for e2e token refresh (make start-web / make test-e2e).
# Both are outputs of the glean-api-dev stack.
COGNITO_CLIENT_ID=<dev UserPoolClientId>
COGNITO_DOMAIN=<dev CognitoDomain>

# Dedicated Cognito test user (scripts/e2e_tokens.sh signs it in).
E2E_USERNAME=<test user email>
E2E_PASSWORD=<test user password>

# AWS CLI service principal (make aws-profile): the 1Password item holding the
# IAM user's key, with fields "access key id" and "secret access key".
# No parentheses in the reference; use the item ID if the title has any.
OP_AWS_ITEM=op://<vault>/<item>
# On a headless box with no 1Password sign-in: run `op` on this host over SSH.
OP_SSH_HOST=<user@mac-with-1password>

# OpenRouter keys are *not* read from here: the dev key goes in backend/.env
# as OPENROUTER_API_KEY, the test key is a GitHub Actions secret for CI, and
# production's lives in Secrets Manager as glean/<env>/openrouter-api-key.
