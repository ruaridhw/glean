# Copy to backend/.env (gitignored) for local runs and integration/soft-gate tests.
# Integration tests read this file; only OPENROUTER_API_KEY is required.

ENVIRONMENT=dev

# ── Required for integration + soft-gate tests ────────────────────────────────
# Real OpenRouter key (sk-or-...). The integration suite skips unless this is set
# to a real sk-or-... value.
OPENROUTER_API_KEY=sk-or-...

# ── Optional ──────────────────────────────────────────────────────────────────
# Only the recipe-search live-smoke test uses this; it skips without a real rapi_... key.
RECIPE_API_KEY=rapi_...

# Auth is dependency-overridden in tests, so these can stay as placeholders locally.
COGNITO_USER_POOL_ID=eu-west-2_XXXXXXXX
COGNITO_APP_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXX
S3_RECEIPTS_BUCKET=glean-receipts-dev

# Per-feature model policy. "{}" (or unset) => each feature uses its
# DEFAULT_LLM_MODEL_POLICY model. Provide a partial JSON map to override specific
# features, e.g. {"meal-plan-generation": {"production_model": "...", "eval_model": "..."}}.
LLM_MODEL_POLICY_OVERRIDES={}

# Eval model overrides (read from this file by the integration conftest). Leave empty
# to evaluate against the per-feature policy models; set to one cheap/free model to run
# every eval against it instead, e.g. google/gemini-2.5-flash-lite.
GLEAN_EVAL_MODEL=
GLEAN_JUDGE_MODEL=

# Optional inputs for the live-smoke cases (those tests skip when unset):
GLEAN_VISION_RECEIPT_IMAGE=
GLEAN_LIVE_RECIPE_URL=

RECEIPT_OCR_MODE=textract

# ── LangSmith tracing (optional) ──────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=glean
LANGSMITH_ENDPOINT=
LANGCHAIN_CALLBACKS_BACKGROUND=false
